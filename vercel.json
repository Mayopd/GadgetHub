{
  "functions": {
    "api/index.js": { "includeFiles": "server/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api|uploads|assets|manifest\\.webmanifest|sw\\.js|workbox-.*|pwa-icon\\.svg).*)", "destination": "/index.html" }
  ]
}